AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# Names of your deployments in Azure; chat and embeddings need separate deployments.
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Actual embedding model behind the deployment (used for token counting).
EMBEDDING_MODEL=text-embedding-3-small
# Cosine relevance cutoff; tune on your own documents, not a probability.
MIN_RELEVANCE=0.25
